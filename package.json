{
	"name": "webext-events",
	"version": "4.0.0",
	"description": "High-level events and utilities for events in Web Extensions",
	"license": "MIT",
	"repository": "fregante/webext-events",
	"funding": "https://github.com/sponsors/fregante",
	"author": "Federico Brigante <me@fregante.com> (https://fregante.com)",
	"type": "module",
	"exports": {
		"./*": "./distribution/*.js"
	},
	"sideEffects": false,
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "tsc",
		"demo:build": "parcel build --no-cache",
		"demo:watch": "parcel watch --no-cache",
		"prepack": "tsc --sourceMap false",
		"test": "tsc --noEmit && xo && vitest run && npm run demo:build",
		"test:watch": "vitest",
		"watch": "tsc --watch"
	},
	"files": [
		"distribution"
	],
	"keywords": [
		"browser",
		"extension",
		"chrome",
		"firefox",
		"safari",
		"webextension",
		"onstartup",
		"extension start event",
		"web-ext"
	],
	"devDependencies": {
		"@parcel/config-webextension": "^2.16.4",
		"@sindresorhus/tsconfig": "^8.1.0",
		"@types/chrome": "^0.3.5",
		"@types/sinon-chrome": "^2.2.16",
		"globals": "^17.13.0",
		"jest-chrome": "^0.8.0",
		"parcel": "^2.16.4",
		"sinon-chrome": "^3.0.1",
		"typescript": "^6.0.3",
		"vitest": "^5.0.5",
		"xo": "^5.0.1"
	},
	"targets": {
		"main": false,
		"default": {
			"engines": {
				"browsers": ""
			},
			"source": "./source/demo/manifest.json",
			"distDir": "./.built/demo",
			"sourceMap": {
				"inline": true
			},
			"optimize": false
		}
	},
	"webExt": {
		"sourceDir": ".built/demo"
	}
}
